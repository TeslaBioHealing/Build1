{%- style -%}
  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      --padding-top: {{ section.settings.padding_top }}px;
      --padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient" style="padding-top: var(--padding-top); padding-bottom: var(--padding-bottom);">
  <div class="page-width">
    <div style="max-width: 62rem; margin: 0 auto 4rem; text-align: center;">
      {%- if section.settings.eyebrow != blank -%}
        <span class="hss-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hss-heading" style="font-size: 3.2rem;">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
    <div class="hss-columns"{% if settings.animations_reveal_on_scroll %} data-cascade{% endif %}>
      {%- for block in section.blocks -%}
        <div class="hss-column{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {{ block.shopify_attributes }}>
          <div class="hss-column__icon">
            {%- render 'hss-icon', icon: block.settings.icon -%}
          </div>
          {%- if block.settings.title != blank -%}
            <h3 class="hss-column__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="hss-column__text">{{ block.settings.text }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <div style="text-align: center; margin-top: 4rem;">
        <a
          {% if section.settings.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.button_link }}"
          {% endif %}
          class="link underlined-link"
        >
          {{- section.settings.button_label | escape -}} →
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HSS Responsible Wellness",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-hss-paper"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Responsible Wellness"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Built Around Responsible Wellness"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Link label",
      "default": "About Healthy Sleep Space"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "chat", "label": "Chat" },
            { "value": "transparency", "label": "Transparency" },
            { "value": "individual", "label": "Individual" }
          ],
          "default": "chat"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Clear Communication"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Understand what each product is, how it is intended to be used, and its limitations.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HSS Responsible Wellness",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "icon": "chat",
            "title": "Clear Communication",
            "text": "<p>Understand what each product is, how it is intended to be used, and its limitations.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "icon": "transparency",
            "title": "Product Transparency",
            "text": "<p>Review features, specifications, directions, safety information, package contents, and policies.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "icon": "individual",
            "title": "Respect for the Individual",
            "text": "<p>Wellness routines and personal experiences vary. Choose what fits your lifestyle and preferences.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
