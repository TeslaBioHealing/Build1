{%- style -%}
  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      --padding-top: {{ section.settings.padding_top }}px;
      --padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  #shopify-section-{{ section.id }} .hss-faq__intro {
    max-width: 74rem;
    margin: 0 auto 3.2rem;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .hss-faq__list {
    max-width: 86rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  #shopify-section-{{ section.id }} details.hss-faq__item {
    background: rgba(255, 255, 255, 0.55);
    border: 0.1rem solid rgba(8, 25, 78, 0.12);
    border-radius: calc(var(--card-corner-radius) * 1px + 0.6rem);
    padding: 1.8rem 2.2rem;
  }
  #shopify-section-{{ section.id }} summary.hss-faq__question {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.6rem;
    font-size: 1.55rem;
    font-weight: 600;
  }
  #shopify-section-{{ section.id }} summary.hss-faq__question::-webkit-details-marker {
    display: none;
  }
  #shopify-section-{{ section.id }} .hss-faq__icon {
    flex: 0 0 auto;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: rgba(247, 186, 33, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    line-height: 1;
    transition: transform 0.2s ease;
  }
  #shopify-section-{{ section.id }} details.hss-faq__item[open] .hss-faq__icon {
    transform: rotate(45deg);
  }
  #shopify-section-{{ section.id }} .hss-faq__answer {
    margin-top: 1.2rem;
    font-size: 1.4rem;
    line-height: 1.7;
    opacity: 0.9;
  }
  #shopify-section-{{ section.id }} .hss-faq__answer p {
    margin: 0 0 1rem;
  }
  #shopify-section-{{ section.id }} .hss-faq__answer p:last-child {
    margin-bottom: 0;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient" style="padding-top: var(--padding-top); padding-bottom: var(--padding-bottom);">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.body != blank -%}
      <div class="hss-faq__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hss-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="hss-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <div>{{ section.settings.body }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="hss-faq__list">
      {%- for block in section.blocks -%}
        <details class="hss-faq__item" {{ block.shopify_attributes }}>
          <summary class="hss-faq__question">
            <span>{{ block.settings.question }}</span>
            <span class="hss-faq__icon" aria-hidden="true">+</span>
          </summary>
          <div class="hss-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HSS FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-hss-paper"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Intro body text (optional)"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 148,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 148,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HSS FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "First question?", "answer": "<p>First answer.</p>" } },
        { "type": "faq", "settings": { "question": "Second question?", "answer": "<p>Second answer.</p>" } }
      ]
    }
  ]
}
{% endschema %}
