{%- style -%}
  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      --padding-top: {{ section.settings.padding_top }}px;
      --padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient" style="padding-top: var(--padding-top); padding-bottom: var(--padding-bottom);">
  <div class="page-width">
    <div class="hss-shop__header-row">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="hss-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="hss-heading" style="font-size: 3rem;">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        <a
          {% if section.settings.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.button_link }}"
          {% endif %}
          class="link underlined-link"
        >
          {{- section.settings.button_label | escape -}} →
        </a>
      {%- endif -%}
    </div>
    <div class="hss-shop__grid"{% if settings.animations_reveal_on_scroll %} data-cascade{% endif %}>
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_title = block.settings.custom_title
          assign card_text = block.settings.custom_text
          assign card_image = block.settings.image
          assign card_url = block.settings.custom_link
          assign is_connected = false

          if block.settings.collection != blank
            assign is_connected = true
            assign card_url = block.settings.collection.url
            if block.settings.custom_title == blank
              assign card_title = block.settings.collection.title
            endif
            if block.settings.image == blank and block.settings.collection.featured_image != blank
              assign card_image = block.settings.collection.featured_image
            endif
          endif
        -%}
        <a
          {% if card_url == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ card_url }}"
          {% endif %}
          class="hss-shop-card{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if request.design_mode and is_connected == false -%}
            <span class="hss-shop-card__unconnected">Connect a collection</span>
          {%- endif -%}
          <div class="hss-shop-card__media">
            {%- if card_image != blank -%}
              {{
                card_image
                | image_url: width: 700
                | image_tag: loading: 'lazy', widths: '300, 400, 500, 700', alt: card_title | escape
              }}
            {%- endif -%}
          </div>
          <div class="hss-shop-card__body">
            {%- if card_title != blank -%}
              <div class="hss-shop-card__title">{{ card_title }}</div>
            {%- endif -%}
            {%- if card_text != blank -%}
              <div class="hss-shop-card__text">{{ card_text }}</div>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HSS Shop Categories",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-hss-paper"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop Wellness"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Products for Every Healthy Sleep Space"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Link label",
      "default": "Shop All Products"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 148,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 148,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "If selected, the card title, image, and link use this collection automatically."
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Title override",
          "info": "Used if no collection is selected, or to override the collection title."
        },
        {
          "type": "text",
          "id": "custom_text",
          "label": "Description"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override",
          "info": "Used if no collection is selected, or to override the collection image."
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Link override (used only if no collection is selected)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HSS Shop Categories",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "custom_title": "Bedroom & Bedside",
            "custom_text": "Create a restful environment right where you sleep."
          }
        },
        {
          "type": "category",
          "settings": {
            "custom_title": "Personal Wellness",
            "custom_text": "Support your wind-down and quiet-time routines."
          }
        },
        {
          "type": "category",
          "settings": {
            "custom_title": "Room & Space",
            "custom_text": "Enhance bedrooms, living areas, and wellness spaces."
          }
        },
        {
          "type": "category",
          "settings": {
            "custom_title": "Travel Wellness",
            "custom_text": "Keep your routine consistent wherever you go."
          }
        },
        {
          "type": "category",
          "settings": {
            "custom_title": "Wellness Sets",
            "custom_text": "Curated combinations to support your routine."
          }
        }
      ]
    }
  ]
}
{% endschema %}
