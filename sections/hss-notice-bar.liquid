{%- style -%}
  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      --padding-top: {{ section.settings.padding_top }}px;
      --padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  #shopify-section-{{ section.id }} .hss-notice-bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    border-radius: calc(var(--card-corner-radius) * 1px + 0.8rem);
    padding: 2.8rem 3.2rem;
  }
  #shopify-section-{{ section.id }} .hss-notice-bar__icon,
  #shopify-section-{{ section.id }} .hss-notice-bar__icon-end {
    flex: 0 0 auto;
    width: 3.6rem;
    height: 3.6rem;
    opacity: 0.85;
  }
  #shopify-section-{{ section.id }} .hss-notice-bar__icon-end {
    margin-left: auto;
    display: none;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .hss-notice-bar__icon-end {
      display: block;
    }
  }
  #shopify-section-{{ section.id }} .hss-notice-bar__text p {
    margin: 0 0 0.4rem;
    font-size: 1.3rem;
    line-height: 1.6;
    opacity: 0.9;
  }
  #shopify-section-{{ section.id }} .hss-notice-bar__text p:first-child {
    font-size: 1.6rem;
    font-weight: 600;
    opacity: 1;
  }
  #shopify-section-{{ section.id }} .hss-notice-bar__text p:last-child {
    margin-bottom: 0;
  }
{%- endstyle -%}

<div class="page-width" style="padding-top: var(--padding-top); padding-bottom: var(--padding-bottom);">
  <div class="hss-notice-bar color-{{ section.settings.color_scheme }}">
    <div class="hss-notice-bar__icon">{%- render 'hss-icon', icon: 'moon' -%}</div>
    <div class="hss-notice-bar__text">
      {%- if section.settings.heading != blank -%}
        <p>{{ section.settings.heading }}</p>
      {%- endif -%}
      {%- if section.settings.line_2 != blank -%}
        <p>{{ section.settings.line_2 }}</p>
      {%- endif -%}
      {%- if section.settings.line_3 != blank -%}
        <p>{{ section.settings.line_3 }}</p>
      {%- endif -%}
    </div>
    <div class="hss-notice-bar__icon-end">{%- render 'hss-icon', icon: 'leaf' -%}</div>
  </div>
</div>

{% schema %}
{
  "name": "HSS Notice Bar",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-hss-navy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Line 1 (bold)",
      "default": "Healthy Sleep Space technology is intended solely for general-wellness use."
    },
    {
      "type": "text",
      "id": "line_2",
      "label": "Line 2",
      "default": "It is not intended to diagnose, treat, cure, mitigate, or prevent any disease or medical condition."
    },
    {
      "type": "text",
      "id": "line_3",
      "label": "Line 3",
      "default": "Nothing on this page is medical advice or a substitute for professional healthcare."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 148,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 148,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "HSS Notice Bar"
    }
  ]
}
{% endschema %}
